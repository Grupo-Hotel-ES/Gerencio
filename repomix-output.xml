type TextoProps = TextProps & {
  tamanho?: number;
  peso?: 400 | 500 | 600 | 700;
  cor?: keyof CoresTema;
};

export function Texto({ tamanho = 14, peso = 400, cor = 'textoPrincipal', style, ...rest }: TextoProps) {
