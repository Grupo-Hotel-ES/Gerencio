} as const satisfies Record<string, SymbolViewProps['name']>;

export type NomeIcone = keyof typeof ICONES;

export function Icone({ nome, cor, tamanho = 20 }: { nome: NomeIcone; cor?: string; tamanho?: number }) {
  const cores = useCores();
