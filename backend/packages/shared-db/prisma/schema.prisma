generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StatusEntregador {
  disponivel
  em_entrega
  inativo
}

enum StatusPedido {
  novo
  em_preparo
  pronto
  saiu_para_entrega
  entregue
  cancelado
}

enum TipoFuncionario {
  PROPRIETARIO
  ENTREGADOR
  CAIXA
}

enum StatusEventoIntegracao {
  pendente
  processando
  processado
  falhou
  erro
}

model Restaurante {
  id          Int                    @id @default(autoincrement())
  cnpj        String                 @unique
  nome        String
  email       String
  telefone    String
  cep         String
  cidade      String
  endereco    String
  credenciais CredencialPlataforma[]
  vinculos    VinculoFuncionario[]
  produtos    Produto[]
  pedidos     Pedido[]
}

model CredencialPlataforma {
  id            Int         @id @default(autoincrement())
  plataforma    String
  clientId      String      @map("client_id")
  accessToken   String      @map("access_token")
  refreshToken  String      @map("refresh_token")
  restauranteId Int         @map("restaurante_id")
  restaurante   Restaurante @relation(fields: [restauranteId], references: [id], onDelete: Cascade)
}

model Funcionario {
  id       Int                  @id @default(autoincrement())
  nome     String
  cpf      String               @unique
  telefone String
  email    String
  tipo     TipoFuncionario      @default(ENTREGADOR)
  status   StatusEntregador?
  vinculos VinculoFuncionario[]
  entregas Entrega[]
}

model VinculoFuncionario {
  restauranteId Int         @map("restaurante_id")
  funcionarioId Int         @map("funcionario_id")
  dataInicio    DateTime    @map("data_inicio")
  dataFim       DateTime?   @map("data_fim")
  restaurante   Restaurante @relation(fields: [restauranteId], references: [id], onDelete: Cascade)
  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)

  @@id([restauranteId, funcionarioId])
}

model Produto {
  id            Int              @id @default(autoincrement())
  nome          String
  preco         Decimal          @db.Decimal(10, 2)
  categoria     String           @default("Sem categoria")
  quantidade    Int              @default(0)
  versaoEstoque Int              @default(0) @map("versao_estoque")
  restauranteId Int              @map("restaurante_id")
  restaurante   Restaurante      @relation(fields: [restauranteId], references: [id], onDelete: Cascade)
  mapeamentos   MapeamentoApp[]
  syncLogs      EstoqueSyncLog[]
  itensPedido   ItemPedido[]
}

model MapeamentoApp {
  id           Int     @id @default(autoincrement())
  plataforma   String
  idExternoApp String  @map("id_externo_app")
  produtoId    Int     @map("produto_id")
  produto      Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)
}

model EstoqueSyncLog {
  id            Int      @id @default(autoincrement())
  plataforma    String
  status        String
  mensagemErro  String?  @map("mensagem_erro")
  dataTentativa DateTime @default(now()) @map("data_tentativa")
  produtoId     Int      @map("produto_id")
  produto       Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
}

model Cliente {
  id          Int      @id @default(autoincrement())
  nomeCliente String   @map("nome_cliente")
  endereco    String
  telefone    String?
  email       String?
  cpf         String?  @unique
  criadoEm    DateTime @default(now()) @map("criado_em")
  pedidos     Pedido[]
}

model Pedido {
  id              Int          @id @default(autoincrement())
  pedidoExternoId String?      @map("pedido_externo_id")
  restauranteId   Int?         @map("restaurante_id")
  restaurante     Restaurante? @relation(fields: [restauranteId], references: [id])
  estoqueBaixado  Boolean      @default(false) @map("estoque_baixado")
  nomeCliente     String?      @map("nome_cliente") // Add este campo
  clienteId       Int?         @map("cliente_id")
  cliente         Cliente?     @relation(fields: [clienteId], references: [id])
  preco           Decimal      @db.Decimal(10, 2)
  metodoPagamento String       @map("metodo_pagamento")
  app             String
  enderecoDestino String       @map("endereco_destino")
  cepDestino      String       @map("cep_destino")
  latitude        Float?
  longitude       Float?
  status          StatusPedido @default(novo)
  criadoEm        DateTime     @default(now()) @map("criado_em")
  itens           ItemPedido[]
  entrega         Entrega?
  eventosIntegracao EventoIntegracao[]

  @@unique([app, pedidoExternoId])
  @@index([restauranteId, status])
}

/// Registro durável das notificações recebidas das plataformas externas.
/// A combinação da plataforma com o evento e com o pedido protege contra
/// reentregas do mesmo webhook antes de qualquer pedido ser criado.
model EventoIntegracao {
  id                       Int                    @id @default(autoincrement())
  plataforma               String
  eventoId                 String                 @map("evento_id")
  pedidoIdExterno          String                 @map("pedido_id_externo")
  lojaIdExterno            String?                @map("loja_id_externo")
  tipo                     String
  payload                  Json
  status                   StatusEventoIntegracao @default(pendente)
  tentativas               Int                    @default(0)
  proximaTentativaEm       DateTime               @default(now()) @map("proxima_tentativa_em")
  processamentoIniciadoEm  DateTime?              @map("processamento_iniciado_em")
  ultimoErro               String?                @map("ultimo_erro")
  processadoEm             DateTime?              @map("processado_em")
  pedidoId                 Int?                   @map("pedido_id")
  pedido                   Pedido?                @relation(fields: [pedidoId], references: [id], onDelete: SetNull)
  criadoEm                 DateTime               @default(now()) @map("criado_em")
  atualizadoEm             DateTime               @updatedAt @map("atualizado_em")

  @@unique([plataforma, eventoId])
  @@unique([plataforma, pedidoIdExterno, tipo])
  @@index([status, proximaTentativaEm])
}

model ItemPedido {
  pedidoId   Int     @map("pedido_id")
  produtoId  Int     @map("produto_id")
  quantidade Int
  pedido     Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto    Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@id([pedidoId, produtoId])
}

model Entrega {
  id           Int          @id @default(autoincrement())
  pedidoId     Int          @unique @map("pedido_id")
  entregadorId Int?         @map("entregador_id")
  custoEntrega Decimal      @map("custo_entrega") @db.Decimal(10, 2)
  dataHora     DateTime     @default(now()) @map("data_hora")
  pedido       Pedido       @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  entregador   Funcionario? @relation(fields: [entregadorId], references: [id])
}
