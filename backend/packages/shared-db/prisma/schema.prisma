generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StatusEntregador {
  disponivel
  em_entrega
  inativo
}

enum StatusPedido {
  novo
  em_preparo
  pronto
  saiu_para_entrega
  entregue
  cancelado
}

enum TipoFuncionario {
  PROPRIETARIO
  ENTREGADOR
  CAIXA
}

enum PapelUsuario {
  administrador
  gerente
  operador
}

enum StatusPagamento {
  pendente
  pago
  expirado
  falhou
}

enum StatusEventoIntegracao {
  pendente
  processando
  processado
  falhou
  erro
}

model Restaurante {
  id                  Int                    @id @default(autoincrement())
  cnpj                String                 @unique
  nome                String
  email               String
  telefone            String
  cep                 String
  cidade              String
  /// Logradouro e número juntos: é o texto usado para localizar o restaurante no mapa
  endereco            String
  razaoSocial         String                 @default("") @map("razao_social")
  categoria           String                 @default("Restaurante")
  logradouro          String                 @default("")
  numero              String                 @default("")
  complemento         String                 @default("")
  bairro              String                 @default("")
  uf                  String                 @default("")
  /// Operação da loja e preferências (horários, loja aberta, notificações...), editadas em Configurações
  configuracoes       Json                   @default("{}")
  latitude            Float?
  longitude           Float?
  taxaEntregaBase     Decimal                @default(6.00) @map("taxa_entrega_base") @db.Decimal(10, 2)
  kmInclusosTaxaBase  Float                  @default(1.0) @map("km_inclusos_taxa_base")
  custoPorKmAdicional Decimal                @default(1.15) @map("custo_por_km_adicional") @db.Decimal(10, 2)
  distanciaMaximaKm   Float?                 @map("distancia_maxima_km")
  credenciais         CredencialPlataforma[]
  vinculos            VinculoFuncionario[]
  produtos            Produto[]
  pedidos             Pedido[]
}

model CredencialPlataforma {
  id            Int         @id @default(autoincrement())
  plataforma    String
  clientId      String      @map("client_id")
  accessToken   String      @map("access_token")
  refreshToken  String      @map("refresh_token")
  restauranteId Int         @map("restaurante_id")
  restaurante   Restaurante @relation(fields: [restauranteId], references: [id], onDelete: Cascade)
}

model Funcionario {
  id       Int                  @id @default(autoincrement())
  nome     String
  cpf      String               @unique
  telefone String
  email    String
  placa    String?
  tipo     TipoFuncionario      @default(ENTREGADOR)
  status   StatusEntregador?
  vinculos VinculoFuncionario[]
  entregas Entrega[]
}

model VinculoFuncionario {
  restauranteId Int         @map("restaurante_id")
  funcionarioId Int         @map("funcionario_id")
  dataInicio    DateTime    @map("data_inicio")
  dataFim       DateTime?   @map("data_fim")
  restaurante   Restaurante @relation(fields: [restauranteId], references: [id], onDelete: Cascade)
  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)

  @@id([restauranteId, funcionarioId])
}

model Produto {
  id            Int              @id @default(autoincrement())
  nome          String
  preco         Decimal          @db.Decimal(10, 2)
  categoria     String           @default("Sem categoria")
  quantidade    Int              @default(0)
  versaoEstoque Int              @default(0) @map("versao_estoque")
  restauranteId Int              @map("restaurante_id")
  restaurante   Restaurante      @relation(fields: [restauranteId], references: [id], onDelete: Cascade)
  mapeamentos   MapeamentoApp[]
  syncLogs      EstoqueSyncLog[]
  itensPedido   ItemPedido[]
}

model MapeamentoApp {
  id           Int     @id @default(autoincrement())
  plataforma   String
  idExternoApp String  @map("id_externo_app")
  produtoId    Int     @map("produto_id")
  produto      Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)
}

model EstoqueSyncLog {
  id            Int      @id @default(autoincrement())
  plataforma    String
  status        String
  mensagemErro  String?  @map("mensagem_erro")
  dataTentativa DateTime @default(now()) @map("data_tentativa")
  produtoId     Int      @map("produto_id")
  produto       Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
}

model Cliente {
  id          Int      @id @default(autoincrement())
  nomeCliente String   @map("nome_cliente")
  endereco    String
  telefone    String?
  email       String?
  cpf         String?  @unique
  criadoEm    DateTime @default(now()) @map("criado_em")
  pedidos     Pedido[]
}

model Pedido {
  id              Int          @id @default(autoincrement())
  pedidoExternoId String?      @map("pedido_externo_id")
  restauranteId   Int?         @map("restaurante_id")
  restaurante     Restaurante? @relation(fields: [restauranteId], references: [id])
  estoqueBaixado  Boolean      @default(false) @map("estoque_baixado")
  nomeCliente     String?      @map("nome_cliente") // Add este campo
  clienteId       Int?         @map("cliente_id")
  cliente         Cliente?     @relation(fields: [clienteId], references: [id])
  preco           Decimal      @db.Decimal(10, 2)
  metodoPagamento String       @map("metodo_pagamento")
  app             String
  enderecoDestino String       @map("endereco_destino")
  cepDestino      String       @map("cep_destino")
  latitude        Float?
  longitude       Float?
  status          StatusPedido @default(novo)
  criadoEm        DateTime     @default(now()) @map("criado_em")
  itens           ItemPedido[]
  entrega         Entrega?
  eventosIntegracao EventoIntegracao[]
  pagamentos      PagamentoPedido[]

  @@unique([app, pedidoExternoId])
  @@index([restauranteId, status])
}

/// Registro durável das notificações recebidas das plataformas externas.
/// A combinação da plataforma com o evento e com o pedido protege contra
/// reentregas do mesmo webhook antes de qualquer pedido ser criado.
model EventoIntegracao {
  id                       Int                    @id @default(autoincrement())
  plataforma               String
  eventoId                 String                 @map("evento_id")
  pedidoIdExterno          String                 @map("pedido_id_externo")
  lojaIdExterno            String?                @map("loja_id_externo")
  tipo                     String
  payload                  Json
  status                   StatusEventoIntegracao @default(pendente)
  tentativas               Int                    @default(0)
  proximaTentativaEm       DateTime               @default(now()) @map("proxima_tentativa_em")
  processamentoIniciadoEm  DateTime?              @map("processamento_iniciado_em")
  ultimoErro               String?                @map("ultimo_erro")
  processadoEm             DateTime?              @map("processado_em")
  pedidoId                 Int?                   @map("pedido_id")
  pedido                   Pedido?                @relation(fields: [pedidoId], references: [id], onDelete: SetNull)
  criadoEm                 DateTime               @default(now()) @map("criado_em")
  atualizadoEm             DateTime               @updatedAt @map("atualizado_em")

  @@unique([plataforma, eventoId])
  @@unique([plataforma, pedidoIdExterno, tipo])
  @@index([status, proximaTentativaEm])
}

/// Link de pagamento online de um pedido (sessão do Stripe Checkout).
/// O status é atualizado pelo webhook do Stripe e pela página de retorno.
model PagamentoPedido {
  id             Int             @id @default(autoincrement())
  pedidoId       Int             @map("pedido_id")
  pedido         Pedido          @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  sessaoStripeId String          @unique @map("sessao_stripe_id")
  url            String
  valor          Decimal         @db.Decimal(10, 2)
  status         StatusPagamento @default(pendente)
  expiraEm       DateTime        @map("expira_em")
  pagoEm         DateTime?       @map("pago_em")
  criadoEm       DateTime        @default(now()) @map("criado_em")

  @@index([pedidoId, status])
}

model ItemPedido {
  pedidoId   Int     @map("pedido_id")
  produtoId  Int     @map("produto_id")
  quantidade Int
  pedido     Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto    Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@id([pedidoId, produtoId])
}

model Entrega {
  id           Int          @id @default(autoincrement())
  pedidoId     Int          @unique @map("pedido_id")
  entregadorId Int?         @map("entregador_id")
  distanciaKm  Float?       @map("distancia_km")
  custoEntrega Decimal      @map("custo_entrega") @db.Decimal(10, 2)
  dataHora     DateTime     @default(now()) @map("data_hora")
  pedido       Pedido       @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  entregador   Funcionario? @relation(fields: [entregadorId], references: [id])
}

/// Pessoas que acessam o painel. O app é de um restaurante só (whitelabel), então não há vínculo com Restaurante.
model Usuario {
  id        Int          @id @default(autoincrement())
  nome      String
  /// Nome de acesso, sempre em minúsculas
  login     String       @unique
  email     String       @default("")
  telefone  String       @default("")
  papel     PapelUsuario @default(operador)
  senhaHash String       @map("senha_hash")
  ativo     Boolean      @default(true)
  criadoEm  DateTime     @default(now()) @map("criado_em")
}

// Estado da conversa do chatbot do WhatsApp, uma linha por telefone.
// Lido e gravado direto pelo workflow do n8n (nó Postgres).
model SessaoChatbot {
  telefone       String   @id
  historico      Json     @default("[]")
  clienteId      Int?     @map("cliente_id")
  pedidoPendente Json?    @map("pedido_pendente")
  ultimoPedidoId Int?     @map("ultimo_pedido_id")
  atualizadoEm   DateTime @default(now()) @map("atualizado_em")
}

// Mensagens recebidas e ainda não respondidas. O workflow espera alguns
// segundos e responde todas de um telefone juntas (debounce).
model MensagemChatbot {
  id         Int      @id @default(autoincrement())
  telefone   String
  mensagemId String   @unique @map("mensagem_id")
  texto      String
  recebidaEm DateTime @default(now()) @map("recebida_em")

  @@index([telefone])
}
